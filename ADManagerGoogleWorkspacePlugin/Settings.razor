@using ADManager.Gui.UI
@using ADManager.Notifications.Services
@using ADManager.Plugins
@using Microsoft.Extensions.Configuration
@inherits AppComponentBase
@attribute [PluginComponent(PageType.Plugin,PageLocation.Settings)]

<MudText>
    Test Plugin Settings
</MudText>

@if (ADManagerGoogleWorkspacePlugin.Configuration != null)
{
    <MudText>Configuration Section: @ADManagerGoogleWorkspacePlugin.Configuration.Path</MudText>
    <MudList T="string">

        @foreach (var child in ADManagerGoogleWorkspacePlugin.Configuration.GetChildren())
        {
            <MudListItem>
                <b>@child.Key</b>: @child.Value
            </MudListItem>
        }
    </MudList>
}
else
{
    <MudText>No configuration found.</MudText>
}

<MudButton OnClick="TestSnackBar">Test Button</MudButton>

@code {
    private void TestSnackBar()
    {
        SnackBarService.Success("Plugin Toast Notification");
    }
}
